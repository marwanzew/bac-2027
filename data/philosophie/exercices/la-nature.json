    {
      "id": "la-nature-probl",
      "titre": "Problématiser : « L'homme doit-il dominer la nature ? »",
      "type": "problematisation",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet de dissertation (créé pour s'entraîner) : « L'homme doit-il dominer la nature ? »",
        "Analyse les termes du sujet, repère la tension et formule une problématique."
      ],
      "methode": [
        "Définis dominer et nature.",
        "Pense à Descartes et à Jonas."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Analyse.** Dominer, c'est maîtriser et soumettre ; la nature est ici l'environnement physique et vivant."
        },
        {
          "type": "paragraphe",
          "texte": "**Tension.** La maîtrise de la nature a permis de nourrir, soigner, protéger les hommes (Descartes). Mais elle menace aujourd'hui les conditions de la vie (climat, biodiversité)."
        },
        {
          "type": "paragraphe",
          "texte": "**Problématique.** La domination de la nature est-elle la condition du progrès humain, ou faut-il la remplacer par une responsabilité envers la nature (Jonas) ?"
        }
      ],
      "bareme": [
        {
          "critere": "Analyse des termes",
          "points": 3
        },
        {
          "critere": "Mise en évidence d'une tension (paradoxe, alternative)",
          "points": 4
        },
        {
          "critere": "Problématique formulée clairement",
          "points": 3
        }
      ]
    }
  ]
