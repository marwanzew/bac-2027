    {
      "id": "etat-probl",
      "titre": "Problématiser : « L'État garantit-il notre liberté ? »",
      "type": "problematisation",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet de dissertation (créé pour s'entraîner) : « L'État garantit-il notre liberté ? »",
        "Analyse les termes du sujet, repère la tension et formule une problématique."
      ],
      "methode": [
        "Définis État et liberté.",
        "Pense à Hobbes (sécurité) et à Locke / Montesquieu (limites)."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Analyse.** L'État exerce un pouvoir souverain et dispose de la force ; la liberté peut être l'absence de contrainte ou la capacité d'agir à l'abri des autres."
        },
        {
          "type": "paragraphe",
          "texte": "**Tension.** Sans État, la liberté de chacun est menacée par les autres (Hobbes). Mais l'État peut lui-même devenir une menace : contrôle, censure, abus de pouvoir."
        },
        {
          "type": "paragraphe",
          "texte": "**Problématique.** L'État est-il la condition de la liberté ou son principal danger ? À quelles conditions protège-t-il la liberté au lieu de la détruire ?"
        }
      ],
      "bareme": [
        {
          "critere": "Analyse des termes",
          "points": 3
        },
        {
          "critere": "Mise en évidence d'une tension (paradoxe, alternative)",
          "points": 4
        },
        {
          "critere": "Problématique formulée clairement",
          "points": 3
        }
      ]
    }
  ]
