  "parties": [
    {
      "id": "evaluation",
      "titre": "Comment tu es évalué",
      "blocs": [
        {
          "type": "piege",
          "titre": "comment tu es évalué",
          "texte": "En LVA, la note du bac vient du **contrôle continu** (coefficient 6) : tes moyennes de première et de terminale. Le niveau visé en fin de terminale est **B2**."
        },
        {
          "type": "paragraphe",
          "texte": "Le niveau **B2** signifie : comprendre l'essentiel de textes complexes, argumenter clairement, nuancer, interagir avec aisance."
        }
      ]
    },
    {
      "id": "comprehension",
      "titre": "Comprendre",
      "blocs": [
        {
          "type": "liste",
          "items": [
            "Avant de lire ou d'écouter : titre, source, date, image → hypothèses.",
            "Repère : who, what, where, when, why, how.",
            "Attention aux faux amis : *actually* (en fait), *eventually* (finalement), *sensible* (raisonnable), *to realise* (se rendre compte).",
            "Audio : première écoute globale, puis prise de notes (mots-clés, chiffres, noms)."
          ]
        }
      ]
    },
    {
      "id": "expression",
      "titre": "Écrire et parler",
      "blocs": [
        {
          "type": "liste",
          "items": [
            "Introduction : présenter le sujet et annoncer l'idée générale.",
            "Développement : 2 ou 3 arguments, chacun avec un exemple.",
            "Conclusion : avis nuancé."
          ]
        },
        {
          "type": "tableau",
          "titre": "Connecteurs",
          "colonnes": [
            "English",
            "Français"
          ],
          "lignes": [
            [
              "First of all / Moreover / Finally",
              "Tout d'abord / De plus / Enfin"
            ],
            [
              "However / Nevertheless",
              "Cependant / Néanmoins"
            ],
            [
              "Therefore / As a result",
              "Donc / En conséquence"
            ],
            [
              "For instance",
              "Par exemple"
            ],
            [
              "To conclude / All things considered",
              "Pour conclure / Tout bien considéré"
            ]
          ]
        },
        {
          "type": "piege",
          "titre": "les erreurs fréquentes",
          "texte": "Oublier le -s à la 3e personne du singulier (*she thinks*) ; *people is* au lieu de *people are* ; *informations* au lieu de *information* (indénombrable) ; *depend of* au lieu de *depend on*."
        }
      ]
    }
  ],
