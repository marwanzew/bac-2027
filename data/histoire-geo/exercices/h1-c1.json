    {
      "id": "h1-c1-composition",
      "titre": "Plan de composition : « La crise de 1929, une crise économique et politique mondiale »",
      "type": "plan-composition",
      "difficulte": "bac",
      "dureeMinutes": 40,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet (créé pour s'entraîner) : « La crise de 1929, une crise économique et politique mondiale »",
        "Rédige l'introduction (accroche, définition des termes, bornes, problématique, annonce) et un plan détaillé avec des exemples précis."
      ],
      "methode": [
        "Définis les termes et les bornes chronologiques ou spatiales.",
        "Problématique : une question qui guide toute la composition.",
        "2 ou 3 parties, chacune avec 2 ou 3 sous-parties et des exemples datés et localisés."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Introduction** : accroche (jeudi noir, 24 octobre 1929) ; définition de la crise ; bornes 1929-1939 ; problématique : comment une crise boursière américaine devient-elle une crise économique, sociale et politique mondiale ?"
        },
        {
          "type": "paragraphe",
          "texte": "**I. Une crise économique devenue mondiale**"
        },
        {
          "type": "liste",
          "items": [
            "A. Le krach et ses causes (spéculation à crédit)",
            "B. La diffusion : capitaux rapatriés, effondrement du commerce, protectionnisme",
            "C. L'exemple de l'Amérique latine"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**II. Une crise sociale et politique**"
        },
        {
          "type": "liste",
          "items": [
            "A. Le chômage de masse et la misère",
            "B. Les démocraties répondent : New Deal (1933), Front populaire et accords Matignon (1936)",
            "C. Mais la crise favorise les régimes autoritaires : Hitler chancelier (1933), Vargas (1930)"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**Conclusion** : une crise qui fragilise les démocraties et prépare le terrain des totalitarismes."
        }
      ],
      "bareme": [
        {
          "critere": "Introduction (termes, bornes, problématique)",
          "points": 4
        },
        {
          "critere": "Plan cohérent qui répond à la problématique",
          "points": 6
        },
        {
          "critere": "Connaissances précises (dates, lieux, acteurs)",
          "points": 6
        },
        {
          "critere": "Conclusion",
          "points": 2
        },
        {
          "critere": "Expression",
          "points": 2
        }
      ]
    }
