{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progression.schema.json",
  "title": "Progression (localStorage, clé « bac2027:progression » ; même format pour l'export / import)",
  "type": "object",
  "required": ["format", "version", "chapitres", "exercices", "favoris", "flashcards", "temps", "serie", "badges", "reglages"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "bac2027-progression" },
    "version": { "type": "integer", "minimum": 1, "description": "Augmente si le format change ; le site migre les anciennes sauvegardes." },
    "exporteLe": { "type": "string", "format": "date-time" },
    "chapitres": {
      "description": "Clé = matiere/chapitre.",
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+/[a-z0-9-]+$": {
          "type": "object", "required": ["statut"], "additionalProperties": false,
          "properties": {
            "statut": { "enum": ["a-faire", "en-cours", "maitrise"] },
            "derniereVisite": { "type": "string", "format": "date-time" },
            "quiz": {
              "type": "object", "required": ["meilleur", "total"], "additionalProperties": false,
              "properties": { "meilleur": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 1 } }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "exercices": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+/[a-z0-9-]+$": {
          "type": "object", "required": ["etat"], "additionalProperties": false,
          "properties": {
            "etat": { "enum": ["reussi", "a-refaire"] },
            "score": { "type": "number" },
            "le": { "type": "string", "format": "date-time" }
          }
        }
      },
      "additionalProperties": false
    },
    "favoris": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(chapitre|definition|exercice):[a-z0-9-]+/[a-z0-9-]+$" }
    },
    "flashcards": {
      "description": "Clé = matiere/definition.",
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+/[a-z0-9-]+$": {
          "type": "object", "required": ["connu", "vues"], "additionalProperties": false,
          "properties": { "connu": { "type": "boolean" }, "vues": { "type": "integer", "minimum": 0 } }
        }
      },
      "additionalProperties": false
    },
    "temps": {
      "description": "Minutes de travail par jour et par matière : { \"2026-10-17\": { \"ses\": 25 } }.",
      "type": "object",
      "patternProperties": {
        "^\\d{4}-\\d{2}-\\d{2}$": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
      },
      "additionalProperties": false
    },
    "serie": {
      "description": "Jours consécutifs avec au moins une activité.",
      "type": "object", "required": ["actuelle", "record"], "additionalProperties": false,
      "properties": {
        "actuelle": { "type": "integer", "minimum": 0 },
        "record": { "type": "integer", "minimum": 0 },
        "dernierJour": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "obtenuLe"], "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "obtenuLe": { "type": "string", "format": "date-time" } }
      }
    },
    "reprise": {
      "description": "« Reprendre où j'en étais ».",
      "type": "object", "required": ["route", "titre"], "additionalProperties": false,
      "properties": { "route": { "type": "string", "pattern": "^#/" }, "titre": { "type": "string" } }
    },
    "reglages": {
      "type": "object", "required": ["theme", "taillePourcent"], "additionalProperties": false,
      "properties": {
        "theme": { "enum": ["systeme", "clair", "sombre"] },
        "taillePourcent": { "type": "integer", "minimum": 90, "maximum": 140 },
        "animations": { "type": "boolean" },
        "pomodoro": {
          "type": "object", "additionalProperties": false,
          "properties": { "travail": { "type": "integer", "minimum": 5, "maximum": 90 }, "pause": { "type": "integer", "minimum": 1, "maximum": 30 } }
        },
        "datesEpreuves": {
          "description": "Dates saisies par l'utilisateur pour les épreuves modifiables.",
          "type": "object", "additionalProperties": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
