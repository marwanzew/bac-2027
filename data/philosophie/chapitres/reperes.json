  "objectifs": [
    "Connaître les couples de notions (repères) du programme.",
    "Savoir les utiliser pour analyser un sujet ou un texte.",
    "Ne pas les réciter : les mobiliser au service d'un problème."
  ],
  "parties": [
    {
      "id": "usage",
      "titre": "À quoi servent les repères ?",
      "blocs": [
        {
          "type": "paragraphe",
          "texte": "Les repères sont des **distinctions conceptuelles** (« légal / légitime », « en fait / en droit »…) qui aident à **analyser un sujet**, à **poser un problème** et à **lire un texte**."
        },
        {
          "type": "piege",
          "titre": "ce n'est pas un cours à part",
          "texte": "Le programme précise que les repères ne font pas l'objet d'un enseignement séparé et ne doivent pas être réduits à des définitions figées : apprends leur sens, puis entraîne-toi à les utiliser dans un sujet."
        },
        {
          "type": "exemple",
          "titre": "Exemple d'utilisation",
          "texte": "« Doit-on toujours obéir aux lois ? » → le repère **légal / légitime** fait apparaître le problème : une loi peut être légale sans être juste."
        }
      ]
    },
