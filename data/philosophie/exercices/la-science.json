    {
      "id": "la-science-probl",
      "titre": "Problématiser : « Les vérités scientifiques sont-elles définitives ? »",
      "type": "problematisation",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet de dissertation (créé pour s'entraîner) : « Les vérités scientifiques sont-elles définitives ? »",
        "Analyse les termes du sujet, repère la tension et formule une problématique."
      ],
      "methode": [
        "Pense à l'histoire des sciences (Terre plate, Newton puis Einstein).",
        "Distingue progrès et relativisme."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Analyse.** Une vérité définitive ne serait plus jamais remise en cause. Les vérités scientifiques sont établies par des méthodes rigoureuses."
        },
        {
          "type": "paragraphe",
          "texte": "**Tension.** La science se distingue de l'opinion par sa rigueur, et certaines connaissances semblent acquises (la Terre tourne autour du Soleil). Mais l'histoire montre que des théories admises ont été dépassées, et une loi générale ne peut jamais être prouvée par un nombre fini d'expériences (Popper)."
        },
        {
          "type": "paragraphe",
          "texte": "**Problématique.** Le caractère provisoire des théories scientifiques est-il une faiblesse qui les rapproche de l'opinion, ou au contraire la marque de leur rationalité ?"
        }
      ],
      "bareme": [
        {
          "critere": "Analyse des termes",
          "points": 3
        },
        {
          "critere": "Mise en évidence d'une tension (paradoxe, alternative)",
          "points": 4
        },
        {
          "critere": "Problématique formulée clairement",
          "points": 3
        }
      ]
    }
  ]
}