    {
      "id": "climat-albedo",
      "titre": "Calculer une puissance réfléchie",
      "type": "raisonnement-scientifique",
      "difficulte": "moyen",
      "dureeMinutes": 15,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Une surface reçoit une puissance solaire de 340 W/m². Calcule la puissance réfléchie par m² si la surface est (a) de la glace d'albédo 0,6, (b) de l'océan d'albédo 0,06.",
        "Explique en quoi la fonte de la banquise constitue une rétroaction positive."
      ],
      "methode": [
        "Puissance réfléchie = albédo × puissance reçue.",
        "Rétroaction : la conséquence (moins de glace) renforce la cause (réchauffement)."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "(a) 0,6 × 340 = **204 W/m²** réfléchis. (b) 0,06 × 340 ≈ **20 W/m²** réfléchis."
        },
        {
          "type": "paragraphe",
          "texte": "Quand la glace fond, elle est remplacée par de l'océan : la surface réfléchit environ dix fois moins et absorbe donc plus d'énergie. Elle se réchauffe davantage, ce qui fait fondre encore plus de glace : c'est une **rétroaction positive**, qui amplifie le réchauffement."
        }
      ],
      "bareme": [
        {
          "critere": "Calculs justes avec unités",
          "points": 4
        },
        {
          "critere": "Explication de la rétroaction",
          "points": 4
        },
        {
          "critere": "Rédaction claire",
          "points": 2
        }
      ]
    }
  ]
}