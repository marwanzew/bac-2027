{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commun.schema.json",
  "title": "Définitions communes",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identifiant court : minuscules, chiffres et tirets (ex. croissance-ex1)."
    },
    "texte": {
      "type": "string",
      "minLength": 1,
      "description": "Texte avec mini-balisage autorisé : **gras**, *italique*, ^exposant^, _{indice}, [[terme du glossaire]]."
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "type": "object",
      "required": ["titre"],
      "additionalProperties": false,
      "properties": {
        "titre": { "type": "string", "minLength": 1, "description": "Ex. « Programme de SES de terminale, BO spécial n° 8 du 25 juillet 2019 »." },
        "url": { "type": "string", "pattern": "^https://" },
        "consulteLe": { "$ref": "#/$defs/date" }
      }
    },
    "certitude": {
      "type": "string",
      "enum": ["certain", "a_verifier"],
      "description": "a_verifier affiche un badge « À VÉRIFIER » sur le site."
    },
    "verifiable": {
      "description": "Champs exigés sur toute affirmation factuelle (définition, repère, chiffre, citation).",
      "type": "object",
      "required": ["certitude", "source"],
      "properties": {
        "certitude": { "$ref": "#/$defs/certitude" },
        "source": { "$ref": "#/$defs/source" },
        "raison": { "type": "string", "description": "Obligatoire si a_verifier : pourquoi le point est douteux." }
      },
      "if": { "properties": { "certitude": { "const": "a_verifier" } } },
      "then": { "required": ["raison"] }
    },
    "tableau": {
      "type": "object",
      "required": ["type", "colonnes", "lignes"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tableau" },
        "titre": { "type": "string" },
        "colonnes": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "lignes": { "type": "array", "minItems": 1, "items": { "type": "array", "items": { "$ref": "#/$defs/texte" } } }
      }
    },
    "schema": {
      "type": "object",
      "description": "Schéma dessiné en SVG par le code : boîtes (noeuds) reliées par des flèches (liens).",
      "required": ["type", "noeuds", "liens"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "schema" },
        "titre": { "type": "string" },
        "sens": { "enum": ["horizontal", "vertical"], "default": "horizontal" },
        "noeuds": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "required": ["id", "texte"], "additionalProperties": false,
            "properties": { "id": { "$ref": "#/$defs/id" }, "texte": { "type": "string" } }
          }
        },
        "liens": {
          "type": "array",
          "items": {
            "type": "object", "required": ["de", "vers"], "additionalProperties": false,
            "properties": {
              "de": { "$ref": "#/$defs/id" },
              "vers": { "$ref": "#/$defs/id" },
              "texte": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
