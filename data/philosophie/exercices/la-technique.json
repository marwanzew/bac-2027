    {
      "id": "la-technique-probl",
      "titre": "Problématiser : « La technique est-elle neutre ? »",
      "type": "problematisation",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet de dissertation (créé pour s'entraîner) : « La technique est-elle neutre ? »",
        "Analyse les termes du sujet, repère la tension et formule une problématique."
      ],
      "methode": [
        "Neutre = ni bonne ni mauvaise, tout dépend de l'usage.",
        "Pense à Heidegger et Jonas."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Analyse.** Dire que la technique est neutre, c'est dire qu'elle n'est qu'un moyen : seul son usage serait bon ou mauvais (un couteau sert à cuisiner ou à tuer)."
        },
        {
          "type": "paragraphe",
          "texte": "**Tension.** C'est vrai d'un outil simple. Mais les techniques modernes (nucléaire, réseaux sociaux, IA) transforment nos manières de vivre, de penser et de percevoir le monde, quel que soit l'usage que nous en faisons (Heidegger)."
        },
        {
          "type": "paragraphe",
          "texte": "**Problématique.** La technique n'est-elle qu'un instrument dont la valeur dépend de notre usage, ou façonne-t-elle elle-même nos fins et notre rapport au monde ?"
        }
      ],
      "bareme": [
        {
          "critere": "Analyse des termes",
          "points": 3
        },
        {
          "critere": "Mise en évidence d'une tension (paradoxe, alternative)",
          "points": 4
        },
        {
          "critere": "Problématique formulée clairement",
          "points": 3
        }
      ]
    }
  ]
