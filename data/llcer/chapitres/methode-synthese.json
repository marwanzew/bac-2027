    {
      "id": "traduction",
      "titre": "Réussir la traduction",
      "blocs": [
        {
          "type": "paragraphe",
          "texte": "La traduction vaut 4 points sur 20, mais elle se prépare : il s'agit d'un passage d'environ 500 signes (3 ou 4 phrases). On attend un français **correct, naturel et fidèle** au sens."
        },
        {
          "type": "tableau",
          "titre": "Techniques de traduction",
          "colonnes": [
            "Technique",
            "Exemple"
          ],
          "lignes": [
            [
              "Transposition (changer la nature d'un mot)",
              "*after he left* → « après son départ »"
            ],
            [
              "Modulation (changer de point de vue)",
              "*the room fell silent* → « le silence se fit dans la pièce »"
            ],
            [
              "Chassé-croisé (verbe de mouvement)",
              "*He swam across the river* → « Il traversa la rivière à la nage »"
            ],
            [
              "Étoffement (ajouter des mots pour être clair)",
              "*the letter lay unopened* → « la lettre restait là, sans avoir été ouverte »"
            ],
            [
              "Passif → « on »",
              "*She was told that…* → « On lui dit que… »"
            ]
          ]
        },
        {
          "type": "tableau",
          "titre": "Les temps du récit",
          "colonnes": [
            "Anglais",
            "Français"
          ],
          "lignes": [
