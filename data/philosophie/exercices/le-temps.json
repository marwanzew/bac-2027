    {
      "id": "le-temps-probl",
      "titre": "Problématiser : « Le temps est-il notre ennemi ? »",
      "type": "problematisation",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet de dissertation (créé pour s'entraîner) : « Le temps est-il notre ennemi ? »",
        "Analyse les termes du sujet, repère la tension et formule une problématique."
      ],
      "methode": [
        "Le temps qui détruit (vieillesse, mort) / le temps qui permet (projet, progrès).",
        "Sénèque, Heidegger."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Analyse.** Un ennemi nous veut du mal et nous combat ; le temps nous fait vieillir, oublier, perdre."
        },
        {
          "type": "paragraphe",
          "texte": "**Tension.** Le temps semble nous détruire : tout passe, tout s'use, nous mourrons. Mais sans temps, rien ne pourrait changer : apprendre, guérir, construire, aimer supposent la durée."
        },
        {
          "type": "paragraphe",
          "texte": "**Problématique.** Le temps est-il une puissance de destruction qui s'impose à nous, ou la condition même de notre liberté et de nos projets, selon l'usage que nous en faisons ?"
        }
      ],
      "bareme": [
        {
          "critere": "Analyse des termes",
          "points": 3
        },
        {
          "critere": "Mise en évidence d'une tension (paradoxe, alternative)",
          "points": 4
        },
        {
          "critere": "Problématique formulée clairement",
          "points": 3
        }
      ]
    }
  ]
