      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Introduction** : définitions (élargissement, approfondissement) ; bornes 1992-2020 ; problématique : la construction européenne progresse-t-elle malgré les crises ?"
        },
        {
          "type": "paragraphe",
          "texte": "**I. Une Union qui s'approfondit**"
        },
        {
          "type": "liste",
          "items": [
            "A. Maastricht (1992) et le marché unique",
            "B. L'euro (1999-2002)",
            "C. Lisbonne (2007)"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**II. Une Union qui s'élargit**"
        },
        {
          "type": "liste",
          "items": [
            "A. 2004 : l'Europe réunifiée",
            "B. Des défis de cohésion"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**III. Une Union remise en question**"
        },
        {
          "type": "liste",
          "items": [
            "A. Le rejet de 2005",
            "B. La crise de l'euro",
            "C. Le Brexit"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**Conclusion** : une construction toujours en débat."
        }
      ],
