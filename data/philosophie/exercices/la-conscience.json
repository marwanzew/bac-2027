    {
      "id": "conscience-probl",
      "titre": "Problématiser : « Se connaître soi-même, est-ce possible ? »",
      "type": "problematisation",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet de dissertation (créé pour s'entraîner) : « Se connaître soi-même, est-ce possible ? »",
        "Analyse les termes du sujet, repère la tension et formule une problématique."
      ],
      "methode": [
        "Pense à Descartes (certitude de soi) et à Leibniz, Freud, Sartre (limites)."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Analyse.** Se connaître : savoir ce que l'on est, ses désirs, son caractère, ses raisons d'agir."
        },
        {
          "type": "paragraphe",
          "texte": "**Tension.** Personne n'est mieux placé que moi pour savoir ce que je pense (Descartes). Pourtant, je me trompe souvent sur mes motifs, j'ignore une part de ce qui se passe en moi et je me mens parfois (mauvaise foi)."
        },
        {
          "type": "paragraphe",
          "texte": "**Problématique.** La conscience nous rend-elle transparents à nous-mêmes, ou la connaissance de soi est-elle une tâche jamais achevée, qui passe aussi par les autres ?"
        }
      ],
      "bareme": [
        {
          "critere": "Analyse des termes",
          "points": 3
        },
        {
          "critere": "Mise en évidence d'une tension (paradoxe, alternative)",
          "points": 4
        },
        {
          "critere": "Problématique formulée clairement",
          "points": 3
        }
      ]
    }
  ]
