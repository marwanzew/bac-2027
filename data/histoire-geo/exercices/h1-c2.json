    {
      "id": "h1-c2-composition",
      "titre": "Plan de composition : « Les régimes totalitaires dans les années 1930 »",
      "type": "plan-composition",
      "difficulte": "bac",
      "dureeMinutes": 40,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet (créé pour s'entraîner) : « Les régimes totalitaires dans les années 1930 »",
        "Rédige l'introduction (accroche, définition des termes, bornes, problématique, annonce) et un plan détaillé avec des exemples précis."
      ],
      "methode": [
        "Définis les termes et les bornes chronologiques ou spatiales.",
        "Problématique : une question qui guide toute la composition.",
        "2 ou 3 parties, chacune avec 2 ou 3 sous-parties et des exemples datés et localisés."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Introduction** : définition du totalitarisme ; trois exemples (Italie, URSS, Allemagne) ; problématique : quels points communs et quelles différences, et quelles conséquences pour l'Europe ?"
        },
        {
          "type": "paragraphe",
          "texte": "**I. Des régimes qui veulent contrôler toute la société**"
        },
        {
          "type": "liste",
          "items": [
            "A. Idéologie, parti unique, culte du chef",
            "B. Propagande et encadrement",
            "C. Terreur : Grande Terreur (1937-1938), nuit de Cristal (1938)"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**II. Des régimes qui menacent l'ordre européen**"
        },
        {
          "type": "liste",
          "items": [
            "A. Des idéologies différentes (communisme / fascisme et nazisme)",
            "B. La guerre d'Espagne (1936-1939), terrain d'affrontement",
            "C. La faiblesse des démocraties (non-intervention)"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**Conclusion** : des régimes qui conduisent l'Europe vers la guerre."
        }
      ],
      "bareme": [
        {
          "critere": "Introduction (termes, bornes, problématique)",
          "points": 4
        },
        {
          "critere": "Plan cohérent qui répond à la problématique",
          "points": 6
        },
        {
          "critere": "Connaissances précises (dates, lieux, acteurs)",
          "points": 6
        },
        {
          "critere": "Conclusion",
          "points": 2
        },
        {
          "critere": "Expression",
          "points": 2
        }
      ]
    }
