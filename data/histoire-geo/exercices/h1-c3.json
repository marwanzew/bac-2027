    {
      "id": "h1-c3-composition",
      "titre": "Plan de composition : « La Seconde Guerre mondiale, une guerre d'anéantissement »",
      "type": "plan-composition",
      "difficulte": "bac",
      "dureeMinutes": 40,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet (créé pour s'entraîner) : « La Seconde Guerre mondiale, une guerre d'anéantissement »",
        "Rédige l'introduction (accroche, définition des termes, bornes, problématique, annonce) et un plan détaillé avec des exemples précis."
      ],
      "methode": [
        "Définis les termes et les bornes chronologiques ou spatiales.",
        "Problématique : une question qui guide toute la composition.",
        "2 ou 3 parties, chacune avec 2 ou 3 sous-parties et des exemples datés et localisés."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Introduction** : définition de la guerre d'anéantissement ; bornes 1939-1945 ; problématique : en quoi la guerre vise-t-elle la destruction totale de l'ennemi, civils compris ?"
        },
        {
          "type": "paragraphe",
          "texte": "**I. Une guerre mondiale et totale**"
        },
        {
          "type": "liste",
          "items": [
            "A. Des fronts sur plusieurs continents (Europe, Pacifique)",
            "B. Le front de l'Est : une guerre idéologique et raciale",
            "C. Toutes les ressources mobilisées"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**II. L'anéantissement des populations**"
        },
        {
          "type": "liste",
          "items": [
            "A. Le génocide des Juifs et des Tsiganes (Einsatzgruppen, Wannsee, Auschwitz)",
            "B. Les violences contre les civils (bombardements, massacres)",
            "C. Hiroshima et Nagasaki (août 1945)"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**Conclusion** : environ 60 millions de morts, un monde à reconstruire (ONU, procès de Nuremberg)."
        }
      ],
      "bareme": [
        {
          "critere": "Introduction (termes, bornes, problématique)",
          "points": 4
        },
        {
          "critere": "Plan cohérent qui répond à la problématique",
          "points": 6
        },
        {
          "critere": "Connaissances précises (dates, lieux, acteurs)",
          "points": 6
        },
        {
          "critere": "Conclusion",
          "points": 2
        },
        {
          "critere": "Expression",
          "points": 2
        }
      ]
    }
  ]
