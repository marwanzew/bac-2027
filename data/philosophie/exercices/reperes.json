    {
      "id": "reperes-probl",
      "titre": "Problématiser : « Doit-on toujours obéir aux lois ? »",
      "type": "problematisation",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet de dissertation (créé pour s'entraîner) : « Doit-on toujours obéir aux lois ? »",
        "Analyse les termes du sujet, repère la tension et formule une problématique."
      ],
      "methode": [
        "Définis « obéir », « loi », et pèse le mot « toujours ».",
        "Utilise le repère légal / légitime.",
        "Formule la problématique sous forme de question qui montre une tension."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Analyse.** Obéir, c'est se conformer à un ordre. La loi est une règle générale établie par une autorité. « Toujours » demande s'il existe des exceptions."
        },
        {
          "type": "paragraphe",
          "texte": "**Tension.** D'un côté, la loi garantit l'ordre et la liberté de tous : désobéir dès qu'une loi déplaît détruirait la vie commune. De l'autre, une loi peut être **légale sans être légitime** : obéir toujours, ce serait parfois participer à l'injustice."
        },
        {
          "type": "paragraphe",
          "texte": "**Problématique possible.** Le respect de la loi est-il un devoir absolu, ou la conscience morale peut-elle autoriser, voire exiger, la désobéissance à une loi injuste ?"
        }
      ],
      "bareme": [
        {
          "critere": "Analyse des termes",
          "points": 3
        },
        {
          "critere": "Mise en évidence d'une tension (paradoxe, alternative)",
          "points": 4
        },
        {
          "critere": "Problématique formulée clairement",
          "points": 3
        }
      ]
    }
  ]
