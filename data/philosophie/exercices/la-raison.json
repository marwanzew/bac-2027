    {
      "id": "la-raison-probl",
      "titre": "Problématiser : « La raison peut-elle tout expliquer ? »",
      "type": "problematisation",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet de dissertation (créé pour s'entraîner) : « La raison peut-elle tout expliquer ? »",
        "Analyse les termes du sujet, repère la tension et formule une problématique."
      ],
      "methode": [
        "Définis raison et expliquer.",
        "Pense à Leibniz (tout a une raison) et à Kant, Pascal (limites)."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Analyse.** Expliquer, c'est rendre compte par des causes ou des raisons. « Tout » inclut la nature, mais aussi l'amour, la foi, le sens de la vie."
        },
        {
          "type": "paragraphe",
          "texte": "**Tension.** La raison progresse sans cesse (sciences) et postule que rien n'arrive sans raison (Leibniz). Mais certaines questions semblent hors de sa portée (Dieu, Kant) et certaines vérités se sentent plutôt qu'elles ne se démontrent (Pascal)."
        },
        {
          "type": "paragraphe",
          "texte": "**Problématique.** La raison a-t-elle un pouvoir illimité d'explication, ou doit-elle reconnaître des limites, voire d'autres voies d'accès au vrai ?"
        }
      ],
      "bareme": [
        {
          "critere": "Analyse des termes",
          "points": 3
        },
        {
          "critere": "Mise en évidence d'une tension (paradoxe, alternative)",
          "points": 4
        },
        {
          "critere": "Problématique formulée clairement",
          "points": 3
        }
      ]
    }
  ]
