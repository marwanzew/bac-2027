    {
      "id": "h2-c3-composition",
      "titre": "Plan de composition : « La France et la décolonisation : la guerre d'Algérie (1954-1962) et ses mémoires »",
      "type": "plan-composition",
      "difficulte": "bac",
      "dureeMinutes": 40,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet (créé pour s'entraîner) : « La France et la décolonisation : la guerre d'Algérie (1954-1962) et ses mémoires »",
        "Rédige l'introduction (accroche, définition des termes, bornes, problématique, annonce) et un plan détaillé avec des exemples précis."
      ],
      "methode": [
        "Définis les termes et les bornes chronologiques ou spatiales.",
        "Problématique : une question qui guide toute la composition.",
        "2 ou 3 parties, chacune avec 2 ou 3 sous-parties et des exemples datés et localisés."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Introduction** : définition (décolonisation, mémoire) ; bornes 1954-1962 et au-delà ; problématique : comment la guerre d'Algérie transforme-t-elle la France et laisse-t-elle des mémoires conflictuelles ?"
        },
        {
          "type": "paragraphe",
          "texte": "**I. Une guerre de décolonisation (1954-1962)**"
        },
        {
          "type": "liste",
          "items": [
            "A. Une colonie de peuplement inégalitaire",
            "B. Une guerre violente (appelés, torture, attentats)",
            "C. Vers l'indépendance : de Gaulle, Évian, 5 juillet 1962"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**II. Une guerre qui change la France**"
        },
        {
          "type": "liste",
          "items": [
            "A. La chute de la IVe République et la Constitution de 1958",
            "B. Le départ des pieds-noirs et des harkis"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**III. Des mémoires concurrentes**"
        },
        {
          "type": "liste",
          "items": [
            "A. Un long silence (« événements » jusqu'en 1999)",
            "B. Des groupes porteurs de mémoires différentes",
            "C. Le travail des historiens"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**Conclusion** : une guerre qui pèse encore sur les relations franco-algériennes."
        }
      ],
      "bareme": [
        {
          "critere": "Introduction (termes, bornes, problématique)",
          "points": 4
        },
        {
          "critere": "Plan cohérent qui répond à la problématique",
          "points": 6
        },
        {
          "critere": "Connaissances précises (dates, lieux, acteurs)",
          "points": 6
        },
        {
          "critere": "Conclusion",
          "points": 2
        },
        {
          "critere": "Expression",
          "points": 2
        }
      ]
