    {
      "id": "le-travail-probl",
      "titre": "Problématiser : « Travaille-t-on seulement pour vivre ? »",
      "type": "problematisation",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet de dissertation (créé pour s'entraîner) : « Travaille-t-on seulement pour vivre ? »",
        "Analyse les termes du sujet, repère la tension et formule une problématique."
      ],
      "methode": [
        "« Seulement » : n'y a-t-il pas d'autres raisons de travailler ?",
        "Pense à Hegel, Marx, Arendt."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Analyse.** Travailler pour vivre, c'est travailler pour satisfaire ses besoins (gagner sa vie). « Seulement » suggère que ce serait la seule raison."
        },
        {
          "type": "paragraphe",
          "texte": "**Tension.** Le travail répond d'abord au besoin : sans nécessité, beaucoup ne travailleraient pas. Mais on cherche aussi dans le travail une reconnaissance, une utilité, une manière de se réaliser (Hegel) ; et quand le travail perd tout sens, il devient aliénant (Marx)."
        },
        {
          "type": "paragraphe",
          "texte": "**Problématique.** Le travail n'est-il qu'un moyen de survivre, ou peut-il être une fin en soi, une manière de devenir soi-même ?"
        }
      ],
      "bareme": [
        {
          "critere": "Analyse des termes",
          "points": 3
        },
        {
          "critere": "Mise en évidence d'une tension (paradoxe, alternative)",
          "points": 4
        },
        {
          "critere": "Problématique formulée clairement",
          "points": 3
        }
      ]
    }
  ]
}