    {
      "id": "verite-probl",
      "titre": "Problématiser : « La vérité est-elle relative ? »",
      "type": "problematisation",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet de dissertation (créé pour s'entraîner) : « La vérité est-elle relative ? »",
        "Analyse les termes du sujet, repère la tension et formule une problématique."
      ],
      "methode": [
        "Définis vérité et relatif.",
        "Distingue domaines : goûts, morale, sciences, mathématiques."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Analyse.** Est relatif ce qui dépend d'un point de vue, d'une époque, d'une culture. La vérité est la conformité d'un énoncé à ce qui est."
        },
        {
          "type": "paragraphe",
          "texte": "**Tension.** Les opinions varient selon les personnes et les époques, et même les théories scientifiques changent. Pourtant, si tout était relatif, la phrase « tout est relatif » le serait aussi, et aucune discussion ne serait possible."
        },
        {
          "type": "paragraphe",
          "texte": "**Problématique.** La diversité des opinions prouve-t-elle qu'il n'existe pas de vérité universelle, ou montre-t-elle seulement que la vérité doit être cherchée avec méthode ?"
        }
      ],
      "bareme": [
        {
          "critere": "Analyse des termes",
          "points": 3
        },
        {
          "critere": "Mise en évidence d'une tension (paradoxe, alternative)",
          "points": 4
        },
        {
          "critere": "Problématique formulée clairement",
          "points": 3
        }
      ]
    }
  ]
