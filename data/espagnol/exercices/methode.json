    {
      "id": "methode-connecteurs",
      "titre": "Réécrire avec des connecteurs",
      "type": "expression-ecrite",
      "difficulte": "moyen",
      "dureeMinutes": 15,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Relie ces phrases avec des connecteurs pour faire un paragraphe : *Internet es útil. Hay muchos bulos. Hay que verificar las informaciones.*"
      ],
      "methode": [
        "Utilise *por un lado, sin embargo, por eso*."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "*Por un lado, Internet es muy útil para informarse. Sin embargo, en las redes sociales hay muchos bulos. Por eso, hay que verificar siempre las informaciones antes de compartirlas.*"
        }
      ],
      "bareme": [
        {
          "critere": "Connecteurs corrects",
          "points": 5
        },
        {
          "critere": "Correction de la langue",
          "points": 5
        }
      ]
    }
