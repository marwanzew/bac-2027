    {
      "id": "h3-c1-composition",
      "titre": "Plan de composition : « Les grands bouleversements du monde de 1973 à 1991 »",
      "type": "plan-composition",
      "difficulte": "bac",
      "dureeMinutes": 40,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet (créé pour s'entraîner) : « Les grands bouleversements du monde de 1973 à 1991 »",
        "Rédige l'introduction (accroche, définition des termes, bornes, problématique, annonce) et un plan détaillé avec des exemples précis."
      ],
      "methode": [
        "Définis les termes et les bornes chronologiques ou spatiales.",
        "Problématique : une question qui guide toute la composition.",
        "2 ou 3 parties, chacune avec 2 ou 3 sous-parties et des exemples datés et localisés."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Introduction** : bornes (premier choc pétrolier 1973 – fin de l'URSS 1991) ; problématique : comment les équilibres économiques et politiques du monde sont-ils transformés ?"
        },
        {
          "type": "paragraphe",
          "texte": "**I. Une économie mondiale transformée**"
        },
        {
          "type": "liste",
          "items": [
            "A. Chocs pétroliers et fin de la croissance",
            "B. Le tournant néolibéral (Thatcher, Reagan)",
            "C. L'ouverture de la Chine (Deng Xiaoping)"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**II. De nouveaux équilibres politiques**"
        },
        {
          "type": "liste",
          "items": [
            "A. Les progrès de la démocratie",
            "B. L'essor de l'islamisme (Iran, 1979)",
            "C. L'effondrement du bloc soviétique (1989-1991)"
          ]
        },
        {
          "type": "paragraphe",
          "texte": "**Conclusion** : la fin d'un monde bipolaire."
        }
      ],
      "bareme": [
        {
          "critere": "Introduction (termes, bornes, problématique)",
          "points": 4
        },
        {
          "critere": "Plan cohérent qui répond à la problématique",
          "points": 6
        },
        {
          "critere": "Connaissances précises (dates, lieux, acteurs)",
          "points": 6
        },
        {
          "critere": "Conclusion",
          "points": 2
        },
        {
          "critere": "Expression",
          "points": 2
        }
      ]
    }
  ]
