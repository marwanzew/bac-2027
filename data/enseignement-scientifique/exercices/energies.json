    {
      "id": "energies-joule",
      "titre": "Pertes en ligne",
      "type": "raisonnement-scientifique",
      "difficulte": "moyen",
      "dureeMinutes": 15,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Une ligne de résistance R = 5 Ω transporte une puissance P = 1 000 000 W (1 MW).",
        "1. Calcule l'intensité et les pertes si U = 10 000 V.",
        "2. Même question si U = 100 000 V.",
        "3. Conclus."
      ],
      "methode": [
        "I = P / U, puis pertes = R × I²."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "1. I = 1 000 000 / 10 000 = **100 A** ; pertes = 5 × 100² = **50 000 W** (5 % de la puissance)."
        },
        {
          "type": "paragraphe",
          "texte": "2. I = 1 000 000 / 100 000 = **10 A** ; pertes = 5 × 10² = **500 W** (0,05 %)."
        },
        {
          "type": "paragraphe",
          "texte": "3. Multiplier la tension par 10 divise l'intensité par 10 et les pertes par 100 : on transporte donc l'électricité en **haute tension**."
        }
      ],
      "bareme": [
        {
          "critere": "Calculs justes avec unités",
          "points": 6
        },
        {
          "critere": "Conclusion",
          "points": 2
        },
        {
          "critere": "Rédaction",
          "points": 2
        }
      ]
    }
  ]
