    {
      "id": "grammaire-transformations",
      "titre": "Analyser et transformer",
      "type": "mobilisation-connaissances",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "1. « Je sais que tu m'attends. » : analyse la manière dont les propositions sont reliées.",
        "2. « Viendras-tu ce soir ? » : identifie l'interrogation, puis transforme-la en interrogative indirecte après « Il veut savoir… ».",
        "3. « Je n'ai rien vu. » : analyse la négation."
      ],
      "methode": [
        "Compte les verbes conjugués ; nomme le mot qui relie ; donne la fonction."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "1. Deux propositions (« sais », « attends ») : « que tu m'attends » est une subordonnée **conjonctive complétive** introduite par « que », complément d'objet direct de « sais » (on peut la remplacer par « cela »)."
        },
        {
          "type": "paragraphe",
          "texte": "2. Interrogation **totale** directe par **inversion** du sujet. Transformation : « Il veut savoir **si tu viendras ce soir**. » (« si », plus d'inversion, plus de point d'interrogation, temps adapté)."
        },
        {
          "type": "paragraphe",
          "texte": "3. Négation **partielle** « ne… rien » : elle porte sur l'objet (on pourrait dire « je n'ai pas vu quelque chose »)."
        }
      ],
      "bareme": [
        {
          "critere": "Identification juste",
          "points": 3
        },
        {
          "critere": "Manipulation montrée",
          "points": 3
        },
        {
          "critere": "Transformation correcte",
          "points": 2
        },
        {
          "critere": "Vocabulaire grammatical précis",
          "points": 2
        }
      ]
    }
