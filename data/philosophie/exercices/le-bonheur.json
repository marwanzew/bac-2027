    {
      "id": "bonheur-probl",
      "titre": "Problématiser : « Le bonheur dépend-il de nous ? »",
      "type": "problematisation",
      "difficulte": "moyen",
      "dureeMinutes": 20,
      "origine": {
        "type": "entrainement"
      },
      "enonce": [
        "Sujet de dissertation (créé pour s'entraîner) : « Le bonheur dépend-il de nous ? »",
        "Analyse les termes du sujet, repère la tension et formule une problématique."
      ],
      "methode": [
        "Distingue ce qui dépend de nous (choix, désirs, jugements) et ce qui n'en dépend pas (santé, chance, autres).",
        "Pense à Épictète et au hasard (étymologie : « bon heur », la bonne chance)."
      ],
      "corrige": [
        {
          "type": "paragraphe",
          "texte": "**Analyse.** « Dépendre de nous » : être en notre pouvoir. Le mot bonheur vient de « bon heur », c'est-à-dire la bonne chance."
        },
        {
          "type": "paragraphe",
          "texte": "**Tension.** Le bonheur semble dépendre de circonstances que nous ne maîtrisons pas (santé, rencontres, richesse). Pourtant, deux personnes dans la même situation ne sont pas également heureuses : notre manière de juger et de désirer compte."
        },
        {
          "type": "paragraphe",
          "texte": "**Problématique.** Le bonheur est-il un don du hasard, ou une conquête de la sagesse qui dépend de notre façon de désirer ?"
        }
      ],
      "bareme": [
        {
          "critere": "Analyse des termes",
          "points": 3
        },
        {
          "critere": "Mise en évidence d'une tension (paradoxe, alternative)",
          "points": 4
        },
        {
          "critere": "Problématique formulée clairement",
          "points": 3
        }
      ]
    }
  ]
